*.log
*.dmp
*.stackdump

# Python tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Standalone native test builds outside bin/obj/out
/tests/**/build/
/tests/**/*.o
/tests/**/*.obj
/tests/**/*.a
/tests/**/*.so
/tests/**/*.so.*
/tests/**/*.dll
/tests/**/*.exe
/tests/**/*.elf
/tests/**/*.map

# Alternate build/package output roots
/artifacts/
/build/
/dist/

# Synthetic fixtures are reviewed exceptions
!tests/fixtures/synthetic/**
AGENTS.md
CLAUDE.md

# PS5 homebrew toolchains (pinned by eng/prospero/dependencies.json)
.deps/
